# Administração local (obrigatório para /admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt:hex_salt:hex_hash
ADMIN_SESSION_SECRET=gere_um_segredo_aleatorio_com_pelo_menos_32_caracteres

# Supabase (valores reais somente em .env.local e Vercel)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=chave_publica_anon_ou_publishable
SUPABASE_SERVICE_ROLE_KEY=chave_privilegiada_service_role_ou_secret

# Vendas continuam desabilitadas; nenhuma variável as ativa.
# Nunca commitar .env.local, senha em texto ou credenciais de produção.
